+expect_in "$err" "error: usage: back_out.sh <state file> <step>" "no usage line"
+run "$state" s4
+[ "$status" -eq 64 ] || fail "an entry not at landing: backed-out did not exit 64 ($status)"
+expect_in "$err" "reads landing: not-started, not backed-out" "the landing state is not named"
+run "$state" s9
+[ "$status" -eq 64 ] || fail "a step with no entry did not exit 64 ($status)"
+run .scratch/p/missing.md s4
+[ "$status" -eq 64 ] || fail "a missing state file did not exit 64 ($status)"
+write_state "$(printf "dispatch:\n- step: s4\n  worktree: .agents/worktrees/s4\n  base: %s\n  landing: backed-out" 1234567)"
+run "$state" s4
+[ "$status" -eq 64 ] || fail "a base that names no commit did not exit 64 ($status)"
+expect_in "$err" "does not name a commit" "the unknown base is not named"
+[ -e "$patch" ] && fail "a refusal wrote a patch"
+run --apply
+[ "$status" -eq 64 ] || fail "--apply with no patch did not exit 64 ($status)"
+expect_in "$err" "error: usage: back_out.sh --apply <patch>" "no usage line for --apply"
+printf 'x\n' >"$test_root/other.patch"
+(cd "$wt" && sh "$script" --apply "$test_root/other.patch") >"$test_root/out" 2>"$test_root/err"
+[ "$?" -eq 64 ] || fail "--apply on a patch not named <step>-backed-out.patch did not exit 64"
+expect_in "$(cat "$test_root/err")" "is not named <step>-backed-out.patch" "the patch's name is not refused"
+[ -d "$wt" ] || fail "a refusal removed the worktree"
+
+printf 'PASS: back_out.sh scratch tests\n'
