+    """A blank line or a comment line, which the entry's removal keeps."""
+    bare = line.strip()
+    return not bare or bare.startswith("#")
+
+
+def without_entry(lines, start, end, step, state):
+    """Return the file's lines with the step's entry removed from the dispatch block.
+
+    Comment and blank lines under dispatch: that are not inside the entry are kept.
+    """
+    key = None
+    for number in range(start, end):
+        if re.match(r"dispatch:\s*(#.*)?$", lines[number].rstrip("\r\n")):
+            key = number
+            break
+    if key is None:
+        raise Refusal(f"the dispatch: key of {state} is not written in block style")
+    stop = key + 1
+    while stop < end:
+        bare = lines[stop].rstrip("\r\n")
+        if bare and not bare.startswith((" ", "-", "#")):
