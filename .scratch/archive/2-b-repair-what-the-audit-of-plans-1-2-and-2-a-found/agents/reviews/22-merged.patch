+                return lines[:key] + [none_line] + rest + lines[stop:]
+            return lines[:first] + lines[last:]
+    raise Refusal(f"the entry of step {step} could not be found in the lines of {state}")
+
+
+def write_checked(path, data, what, in_place=False):
+    """Write data to path and read it back. in_place writes the file itself, so a file that
+    cannot be written is refused rather than replaced."""
+    if in_place:
+        with open(path, "wb") as handle:
+            handle.write(data)
+    else:
+        tmp = path + ".back-out.tmp"
+        with open(tmp, "wb") as handle:
+            handle.write(data)
+        os.replace(tmp, path)
+    with open(path, "rb") as handle:
+        if handle.read() != data:
+            raise OSError(f"{what} {path} does not read back as written")
+
+
+def unquote(name):
+    """A path as git prints it, quoted in C style when it holds special characters."""
+    if len(name) < 2 or not (name.startswith('"') and name.endswith('"')):
+        return name
+    raw = name[1:-1].encode("utf-8").decode("unicode_escape").encode("latin-1")
+    return raw.decode("utf-8", errors="surrogateescape")
+
+
+def header_paths(rest):
+    """The a/ and b/ paths of a diff --git header, for a part with no ---/+++ or rename lines."""
+    if rest.startswith('"'):
+        parts = re.findall(r'"(?:[^"\\]|\\.)*"|\S+', rest)
+        return [unquote(p)[2:] for p in parts[:2]]
+    size = (len(rest) - 5) // 2
+    if len(rest) == 2 * size + 5 and rest[2 + size:5 + size] == " b/" \
+            and rest[2:2 + size] == rest[5 + size:]:
+        return [rest[2:2 + size]]
+    return []
+
+
+def patch_parts(patch):
+    """The patch split into one part per file: a list of (paths, text)."""
+    parts, current = [], None
+    for line in patch.splitlines(keepends=True):
+        if line.startswith("diff --git "):
+            current = [set(), [line]]
+            parts.append(current)
+            continue
+        if current is None:
+            continue
+        current[1].append(line)
+        bare = line.rstrip("\n")
+        for prefix in ("--- a/", "+++ b/", "rename from ", "rename to ", "copy from ", "copy to "):
+            if bare.startswith(prefix):
+                current[0].add(unquote(bare[len(prefix):]))
+        for prefix in ('--- "a/', '+++ "b/'):
+            if bare.startswith(prefix):
+                current[0].add(unquote(bare[4:])[2:])
+    result = []
+    for paths, text in parts:
+        if not paths:
+            paths.update(header_paths(text[0][len("diff --git "):].rstrip("\n")))
+        result.append((paths, "".join(text)))
+    return result
+
+
+def is_binary(text):
+    return any(line.startswith(("GIT binary patch", "Binary files ")) for line in text.splitlines())
+
+
+def glob_escape(path):
+    return re.sub(r"([\\*?\[])", r"\\\1", path)
+
+
+def status_entries():
+    """(code, path) for each entry of git status --porcelain -z, the new path of a rename."""
+    result = git("status", "--porcelain", "-z")
+    if result.returncode != 0:
+        raise OSError("git status failed: " + result.stderr.decode(errors="replace").strip())
+    fields = result.stdout.decode("utf-8", errors="surrogateescape").split("\0")
+    entries, index = [], 0
+    while index < len(fields):
+        field = fields[index]
+        index += 1
+        if not field:
+            continue
+        code, path = field[:2], field[3:]
+        if "R" in code or "C" in code:
+            index += 1
+        entries.append((code, path))
+    return entries
+
+
+def apply_mode(argv):
+    if len(argv) != 1:
+        raise Refusal("usage: back_out.sh --apply <patch>")
+    patch_path = os.path.abspath(argv[0])
+    name = os.path.basename(patch_path)
+    if not name.endswith("-backed-out.patch") or not STEP.fullmatch(name[:-len("-backed-out.patch")]):
+        raise Refusal(f"{argv[0]} is not named <step>-backed-out.patch")
+    step = name[:-len("-backed-out.patch")]
+    patch = read(patch_path)
+    inside = git("rev-parse", "--is-inside-work-tree")
+    if inside.returncode != 0 or inside.stdout.strip() != b"true":
+        raise Refusal("run --apply from inside the step's worktree")
+    parts = patch_parts(patch)
+    known = set().union(*(paths for paths, _ in parts)) if parts else set()
+    skipped, stuck = [], False
+    while True:
+        excludes = [f"--exclude={glob_escape(p)}" for p in skipped]
+        result = git("apply", "--3way", *excludes, patch_path)
+        if result.returncode == 0:
+            break
+        found = []
+        for line in result.stderr.decode("utf-8", errors="surrogateescape").splitlines():
+            if not line.startswith("error: ") or line.startswith(("error: patch failed:",
+                                                                   "error: cannot apply")):
+                continue
+            match = re.fullmatch(r"error: (.+?): [^:]+", line)
+            if match:
+                path = unquote(match.group(1))
+                if path in known and path not in skipped and path not in found:
+                    found.append(path)
+        if not found:
+            stuck = True
+            break
+        skipped.extend(found)
+        if all(paths <= set(skipped) for paths, _ in parts):
+            break
+    skipped_path = os.path.join(os.path.dirname(patch_path), f"{step}-skipped.patch")
+    try:
+        if skipped:
+            text = "".join(part for paths, part in parts if paths & set(skipped))
+            write_checked(skipped_path, text.encode("utf-8", errors="surrogateescape"),
+                          "the skipped part")
+        elif os.path.exists(skipped_path):
+            os.remove(skipped_path)
+        entries = status_entries()
+        if stuck and not any("U" in c or c in ("AA", "DD") for c, _ in entries):
+            sys.stderr.write(result.stderr.decode(errors="replace"))
+            print(f"failed: git apply --3way {patch_path} applied nothing", file=sys.stderr)
+            return 1
+        for path in skipped:
+            print(f"skipped: {path}")
+        clean = not skipped
+        for code, path in entries:
+            if code == "??":
+                continue
+            if "U" in code or code in ("AA", "DD"):
+                clean = False
+                part = next((text for paths, text in parts if path in paths), "")
+                if is_binary(part) and git("checkout", "--theirs", "--", path).returncode == 0 \
+                        and git("add", "--", path).returncode == 0:
+                    print(f"binary: {path}, the patch's copy taken")
+                else:
+                    print(f"conflict: {path}")
+            elif code[0] != " ":
+                print(f"applied: {path}")
+    except OSError as error:
+        print(f"failed: {error}", file=sys.stderr)
+        return 1
+    return 0 if clean else 1
+
+
+def main(argv):
+    if argv and argv[0] == "--apply":
+        return apply_mode(argv[1:])
+    if len(argv) != 2:
+        raise Refusal("usage: back_out.sh <state file> <step>")
+    state, step = argv
+    if not STEP.fullmatch(step):
+        raise Refusal(f"step '{step}' is not a step name: letters, digits, '.', '_' and '-'")
+    try:
+        import yaml  # noqa: F401
+    except ImportError:
+        print("error: python3 cannot import yaml (PyYAML)", file=sys.stderr)
+        return 69
+    remove = os.environ.get("BACK_OUT_REMOVE", "")
+    if not os.path.isfile(remove):
+        print("error: the land skill's templates/remove_worktree.sh is not beside the spec skill",
+              file=sys.stderr)
+        return 69
+    if not os.path.isdir(".git"):
+        raise Refusal("run this script from the repository root of the main checkout")
+    text = read(state)
+    lines, start, end, data = dispatch_block(text, state)
+    entries, _ = entries_of(data)
+    entry = next((e for e in entries if isinstance(e, dict) and str(e.get("step")) == step), None)
+    if entry is None:
+        raise Refusal(f"the dispatch block of {state} has no entry for step {step}")
+    if entry.get("landing") != "backed-out":
+        raise Refusal(f"the entry of step {step} reads landing: {entry.get('landing')}, "
+                      "not backed-out")
+    worktree, base = entry.get("worktree"), entry.get("base")
+    if not isinstance(worktree, str) or not worktree.strip():
+        raise Refusal(f"the entry of step {step} has no worktree: key")
+    if base is None or isinstance(base, bool):
+        raise Refusal(f"the entry of step {step} has no base: key")
+    base = str(base)
+    branch = os.path.basename(os.path.normpath(worktree))
+    for ref in (base + "^{commit}", f"refs/heads/{branch}"):
+        if git("rev-parse", "-q", "--verify", ref).returncode != 0:
+            raise Refusal(f"{ref} does not name a commit")
+
+    new_text = "".join(without_entry(lines, start, end, step, state))
+    _, _, _, new_data = dispatch_block(new_text, state)
+    others = [e for e in entries if not (isinstance(e, dict) and str(e.get("step")) == step)]
+    new_entries, _ = entries_of(new_data)
+    if (others and new_entries != others) or (not others and new_data["dispatch"] != "none"):
+        print(f"failed: the dispatch block of {state} would not hold exactly the other entries",
+              file=sys.stderr)
+        return 1
+    if not os.access(state, os.W_OK):
+        print(f"failed: the state file {state} cannot be written", file=sys.stderr)
+        return 1
+
+    patch = os.path.join(os.path.dirname(state), "agents", "reviews", f"{step}-backed-out.patch")
+    diff = git("diff", "--binary", base, f"refs/heads/{branch}")
+    again = git("diff", "--binary", base, f"refs/heads/{branch}")
+    if diff.returncode != 0 or again.returncode != 0:
+        sys.stderr.write(diff.stderr.decode(errors="replace"))
+        print(f"failed: git diff --binary {base} {branch}", file=sys.stderr)
+        return 1
+    try:
+        if diff.stdout:
+            os.makedirs(os.path.dirname(patch), exist_ok=True)
+            write_checked(patch, diff.stdout, "the patch")
+            if again.stdout != diff.stdout:
+                raise OSError(f"the patch {patch} does not compare equal with the diff")
+            print(f"wrote: {patch}")
+        else:
+            if os.path.exists(patch):
+                os.remove(patch)
+            print("no patch: the diff is empty")
+    except OSError as error:
+        print(f"failed: {error}", file=sys.stderr)
+        return 1
+    sys.stdout.flush()
+
+    removed = subprocess.run(["sh", remove, state, step])
+    if removed.returncode != 0:
+        return removed.returncode
+
+    try:
+        write_checked(state, new_text.encode("utf-8"), "the state file", in_place=True)
+    except OSError as error:
+        print(f"failed: {error}", file=sys.stderr)
+        return 1
+    print(f"removed: dispatch entry {step}")
+    return 0
+
+
+try:
+    sys.exit(main(sys.argv[1:]))
+except Refusal as refusal:
+    print(f"error: {refusal}", file=sys.stderr)
+    sys.exit(64)
+PY
diff --git a/skills/spec/templates/back_out.test.sh b/skills/spec/templates/back_out.test.sh
new file mode 100644
index 0000000..60625c5
--- /dev/null
+++ b/skills/spec/templates/back_out.test.sh
@@ -0,0 +1,319 @@
+#!/bin/sh
+# Exercise back_out.sh on scratch repositories built as land.sh leaves a back-out: the worktree on
+# <branch>-land, <branch> holding the builder's work and the wip commit, and ledger copies left
+# uncommitted in the worktree. Cases: a text change, a new file, a file whose name holds a space
+# and a binary change carried by the patch and restored by back_out.sh --apply in a new worktree
+# from a later main; a text file main changed left unmerged with its markers, and a binary file
+# both sides changed taken as the patch's copy, while the clean files are applied; a file main
+# deleted and one main renamed skipped, named and saved to the skipped part while the rest is
+# applied; the entry removed and every other byte of the state file unchanged, in the list form,
+# the single entry form, and with a comment line or a blank line under dispatch: and between
+# entries; the worktree and both branches gone; a read-only state file refused before anything
+# is removed, then a rerun that goes through; an empty diff, which writes no patch and removes
+# an old one; a refusal of remove_worktree.sh, which leaves the patch, the entry, the worktree
+# and the branches; and each refusal on an argument, a state file or an entry the script cannot
+# use. The test runs the land skill's remove_worktree.sh from this repository, beside this skill.
+
+set -u
+
+fail() {
+    printf 'FAIL: %s\n' "$1" >&2
+    exit 1
+}
+
+test_root=$(mktemp -d "${TMPDIR:-/tmp}/back-out-test.XXXXXX") || fail "could not create scratch directory"
+test_root=$(CDPATH= cd "$test_root" && pwd -P)
+trap 'rm -rf "$test_root"' 0 1 2 3 15
+script=$(CDPATH= cd "$(dirname "$0")" && pwd -P)/back_out.sh
+
+g() {
+    git -c user.name=t -c user.email=t@t "$@"
+}
+
+expect_in() {
+    case "$1" in
+        *"$2"*) ;;
+        *) fail "$3; expected \"$2\" in: $1" ;;
+    esac
+}
+
+run() {
+    sh "$script" "$@" >"$test_root/out" 2>"$test_root/err"
+    status=$?
+    out=$(cat "$test_root/out")
+    err=$(cat "$test_root/err")
+}
+
+# The state file with the given dispatch block text ($1), written to $state.
+write_state() {
+    {
+        printf '# State\n\nThe configuration.\n\n```yaml\nverify:\n- true\n```\n\n```yaml\n'
+        printf '%s\n' "$1"
+        printf '```\n\n## Open items\n\n- none.\n'
+    } >"$state"
+}
+
+# make_repo <name> <step> <folder> [deleted | renamed]: main holds a.txt, b.txt, img.bin,
+# both.bin, del.txt, ren.txt and a ledger; the base is main's head; the worktree <folder> changes
+# a.txt line 2, adds new.txt and "sp ace.txt", and changes img.bin, both.bin, del.txt and ren.txt,
+# commits them as the wip commit and checks out <folder>-land at main, with a report and a
+# changed plan.md left uncommitted in its ledger copy. Then main moves on: a.txt line 2, b.txt and
+# both.bin change, and with a fourth argument main deletes del.txt or renames ren.txt to
+# ren2.txt. Sets repo, wt, state, base, patch and skipped.
+make_repo() {
+    repo=$test_root/$1
+    mkdir -p "$repo/.agents" "$repo/.scratch/p/agents/reviews"
+    cd "$repo" || fail "could not enter $repo"
+    git init -q -b main
+    printf 'ledger_root: .scratch\n' >.agents/plan.yaml
+    printf '.agents/worktrees/\n' >.gitignore
+    printf '# Plan: p\n' >.scratch/p/plan.md
+    : >.scratch/p/agents/reviews/.gitkeep
+    printf '1\n2\n3\n' >a.txt
+    printf 'b\n' >b.txt
+    printf '\000\001\002x' >img.bin
+    printf '\000\001\002y' >both.bin
+    printf 'd\n' >del.txt
+    printf 'r\nr\nr\n' >ren.txt
+    state=.scratch/p/orchestrator-state.md
+    patch=.scratch/p/agents/reviews/$2-backed-out.patch
+    skipped=.scratch/p/agents/reviews/$2-skipped.patch
+    write_state 'dispatch: none'
+    g add -A && g commit -q -m base || fail "could not commit the base"
+    base=$(git rev-parse --short HEAD)
+    wt=$repo/.agents/worktrees/$3
+    git worktree add -q -b "$3" "$wt" main || fail "could not add the worktree"
+    (
+        cd "$wt" || exit 1
+        printf '1\ntwo\n3\n' >a.txt
+        printf 'new\n' >new.txt
+        printf 'spaced\n' >'sp ace.txt'
+        printf '\000\001\002X\003' >img.bin
+        printf '\000\001\002Z\004' >both.bin
+        printf 'd2\n' >del.txt
+        printf 'r\nR\nr\n' >ren.txt
+        g add -A && g commit -q -m wip && git checkout -q -b "$3-land" main
+    ) || fail "could not build the worktree's work"
+    printf 'report\n' >"$wt/.scratch/p/agents/reviews/$2-report.md"
+    printf 'ruling\n' >>"$wt/.scratch/p/plan.md"
+    printf '1\nTWO\n3\n' >a.txt
+    printf 'b2\n' >b.txt
+    printf '\000\001\002M\005' >both.bin
+    case "${4:-}" in
+        deleted) git rm -q del.txt ;;
+        renamed) git mv ren.txt ren2.txt ;;
+    esac
+    g add -A && g commit -q -m moved || fail "could not move main on"
+}
+
+# prepare <folder>: /spec's preparation commit and a new worktree from main at the same folder.
+# Sets new.
+prepare() {
+    g add -A && g commit -q -m prepare || fail "could not make the preparation commit"
+    new=$repo/.agents/worktrees/$1
+    git worktree add -q -b "$1" "$new" main || fail "could not add the new worktree"
+}
+
+# apply: back_out.sh --apply on the patch from inside the new worktree; sets out, err, status.
+apply() {
+    (cd "$new" && sh "$script" --apply "$repo/$patch") >"$test_root/out" 2>"$test_root/err"
+    status=$?
+    out=$(cat "$test_root/out")
+    err=$(cat "$test_root/err")
+}
+
+# The list form: the step's entry between two others, with a comment kept.
+list_block() {
+    printf 'dispatch:                    # the steps in flight\n'
+    printf -- "- step: first\n  worktree: .agents/worktrees/first\n  landing: not-started\n"
+    printf -- "- step: '%s'\n  worktree: .agents/worktrees/%s\n  base: %s\n  landing: backed-out\n  round: 1\n" \
+        "$1" "$2" "$3"
+    printf -- "- step: last\n  worktree: .agents/worktrees/last\n  landing: not-started\n"
+}
+
+# The patch carries every change, the entry goes, the rest of the state file is unchanged, and the
+# worktree and both branches are gone. Red when --binary is dropped (the patch holds no binary
+# content), when the entry is removed with its neighbours or not at all, or when the worktree or a
+# branch is left.
+make_repo full 22 2b-22
+write_state "$(list_block 22 2b-22 "$base" | sed '/^- step: .22.$/,/^  round: 1$/d')"
+cp "$state" "$test_root/expected"
+write_state "$(list_block 22 2b-22 "$base")"
+run "$state" 22
+[ "$status" -eq 0 ] || fail "the back-out failed: $out $err"
+[ -f "$patch" ] || fail "no patch at $patch"
+expect_in "$out" "wrote: $patch" "the patch's write is not reported"
+expect_in "$(cat "$patch")" "GIT binary patch" "the patch carries no binary content"
+expect_in "$out" "removed: worktree .agents/worktrees/2b-22" "the worktree's removal is not reported"
+expect_in "$out" "removed: dispatch entry 22" "the entry's removal is not reported"
+cmp -s "$state" "$test_root/expected" ||
+    fail "the state file is not the old one without the entry: $(diff "$test_root/expected" "$state")"
+[ -e "$wt" ] && fail "the worktree is still there"
+for branch in 2b-22 2b-22-land; do
+    git rev-parse -q --verify "refs/heads/$branch" >/dev/null && fail "branch $branch is still there"
+done
+
+# /spec's preparation and new worktree, then back_out.sh --apply: the clean files applied, the text
+# file main changed left unmerged, and the binary file both sides changed taken as the patch's
+# copy. Red when the patch lacks the binary content (img.bin is not restored), when the apply mode
+# does not take the patch's copy of a binary in conflict, or when a line is missing.
+prepare 2b-22
+apply
+[ "$status" -eq 1 ] || fail "--apply with a conflict did not exit 1 ($status): $out $err"
+for line in "applied: new.txt" "applied: sp ace.txt" "applied: img.bin" "applied: del.txt" \
+    "applied: ren.txt" "conflict: a.txt" "binary: both.bin, the patch's copy taken"; do
+    expect_in "$out" "$line" "the apply's line is missing"
+done
+case "$out" in
+    *"skipped:"* | *"conflict: both.bin"*) fail "--apply skipped a file or left the binary unmerged: $out" ;;
+esac
+[ -e "$repo/$skipped" ] && fail "--apply wrote a skipped part with nothing skipped"
+shortstatus=$(cd "$new" && git status --short)
+expect_in "$shortstatus" "UU a.txt" "a.txt, which main changed, is not unmerged"
+expect_in "$shortstatus" "M  both.bin" "both.bin is not staged as the patch's copy"
+expect_in "$shortstatus" "A  new.txt" "the new file is not applied"
+expect_in "$shortstatus" 'A  "sp ace.txt"' "the file whose name holds a space is not applied"
+expect_in "$shortstatus" "M  img.bin" "the binary change is not applied"
+[ "$(cat "$new/new.txt")" = new ] || fail "new.txt does not hold the builder's text"
+[ "$(cat "$new/sp ace.txt")" = spaced ] || fail "sp ace.txt does not hold the builder's text"
+printf '\000\001\002X\003' | cmp -s - "$new/img.bin" || fail "img.bin is not the builder's copy"
+printf '\000\001\002Z\004' | cmp -s - "$new/both.bin" || fail "both.bin in conflict is not the patch's copy"
+expect_in "$(cat "$new/a.txt")" "<<<<<<<" "a.txt holds no conflict markers"
+expect_in "$(cat "$new/a.txt")" "two" "a.txt's markers do not hold the builder's line"
+[ "$(cat "$new/b.txt")" = b2 ] || fail "b.txt is not main's copy"
+
+# Main deleted, or renamed, a file the patch changes: git apply --3way alone applies nothing, so
+# --apply excludes that file, applies the rest, names it on a skipped: line and writes its part of
+# the patch to <step>-skipped.patch. Red when the apply is not run again without the file, or
+# when the skipped part is not written.
+for how in deleted:del.txt renamed:ren.txt; do
+    make_repo "${how%%:*}" s5 s5 "${how%%:*}"
+    write_state "$(list_block s5 s5 "$base")"
+    run "$state" s5
+    [ "$status" -eq 0 ] || fail "the back-out failed: $out $err"
+    prepare s5
+    apply
+    [ "$status" -eq 1 ] || fail "--apply with a skipped file did not exit 1 ($status): $out $err"
+    expect_in "$out" "skipped: ${how#*:}" "the file main ${how%%:*} is not named"
+    expect_in "$out" "applied: new.txt" "the other files are not applied when main ${how%%:*} a file"
+    expect_in "$out" "conflict: a.txt" "a.txt is not left unmerged when main ${how%%:*} a file"
+    [ "$(cat "$new/new.txt" 2>/dev/null)" = new ] || fail "new.txt is not on disk when main ${how%%:*} a file"
+    [ -f "$repo/$skipped" ] || fail "no skipped part at $skipped"
+    expect_in "$(cat "$repo/$skipped")" "diff --git a/${how#*:} b/${how#*:}" "the skipped part lacks the file"
+    case "$(cat "$repo/$skipped")" in
+        *"a/a.txt"*) fail "the skipped part holds a file that was applied" ;;
+    esac
+done
+
+# An apply that fails and names no file it can exclude (a corrupt patch), with nothing left
+# unmerged, is a failure, not a clean apply. Red when --apply then exits 0 or prints no failed: line.
+(cd "$new" && git reset -q --hard && git clean -q -fd) || fail "could not reset the new worktree"
+printf 'diff --git a/b.txt b/b.txt\n--- a/b.txt\n+++ b/b.txt\n@@ -1,3 +1,3 @@\n-x\n' \
+    >"$test_root/g-backed-out.patch"
+(cd "$new" && sh "$script" --apply "$test_root/g-backed-out.patch") >"$test_root/out" 2>"$test_root/err"
+[ "$?" -eq 1 ] || fail "an apply that applied nothing did not exit 1"
+expect_in "$(cat "$test_root/err")" "applied nothing" "the apply that applied nothing is not named"
+
+# The single-entry form becomes dispatch: none. Red when that form is not rewritten.
+make_repo single s1 s1
+write_state 'dispatch: none'
+cp "$state" "$test_root/expected"
+write_state "$(printf "dispatch:\n  step: s1\n  worktree: .agents/worktrees/s1\n  base: %s\n  landing: backed-out" "$base")"
