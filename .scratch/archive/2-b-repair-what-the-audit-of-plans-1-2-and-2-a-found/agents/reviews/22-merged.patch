index 0000000..566e89b
--- /dev/null
+++ b/skills/land/templates/remove_worktree.sh
@@ -0,0 +1,207 @@
+#!/bin/sh
+# Remove a step's worktree and its branches, once every change in the worktree is a ledger copy.
+#
+# Usage: sh remove_worktree.sh <state file> <step>, from the repository root of the main checkout.
+#
+# The worktree is the worktree: key of the step's entry in the dispatch block of the state file
+# (the dispatch: key of its first yaml block that has one: an entry, or a list of entries, each
+# with a step: key), a path relative to the repository root. The branches are the worktree
+# folder's name and that name with -land after it, as land.sh names them from its package
+# argument; no path or branch is built from the step id.
+#
+# From inside the worktree, git status --porcelain -z --untracked-files=all lists every change,
+# untracked files included, both paths of a rename. Each path must be under the ledger root: the
+# ledger_root of .agents/plan.yaml, or, in its projects: form, the project's ledger_root that the
+# state file's folder sits under. The ledger is written only on main, so its copies in the
+# worktree are records already saved there or copies the orchestrator put there. A path outside
+# the ledger root prints "refused: <path> is outside the ledger root", and the script exits 1
+# having removed nothing.
+#
+# Otherwise it runs git worktree remove --force on the worktree (without --force, git refuses a
+# worktree holding untracked or modified files), then git branch -D on each branch that exists,
+# and checks after each that the thing is gone. It prints one line per thing removed:
+# "removed: worktree <path>", "removed: branch <name>".
+#
+# Exit status: 0 removed; 1 refused, or a git command failed, with its output; 64 an argument, a
+# state file, a dispatch entry, .agents/plan.yaml or a worktree it cannot use, or a run from
+# anywhere but the main checkout's root; 69 python3 or PyYAML missing.
+
+if ! command -v python3 >/dev/null 2>&1; then
+    printf 'error: python3 is not on PATH\n' >&2
+    exit 69
+fi
+exec python3 - "$@" <<'PY'
+import os
+import re
+import subprocess
+import sys
+
+STEP = re.compile(r"[A-Za-z0-9][A-Za-z0-9._-]*")
+FENCE = re.compile(r" {0,3}(`{3,}|~{3,})\s*([^`\s]*)[^`]*")
+
+
+class Refusal(Exception):
+    """An input the script cannot use; the message says why."""
+
+
+def git(*args, cwd=None):
+    return subprocess.run(("git",) + args, cwd=cwd, capture_output=True)
+
+
+def yaml_blocks(path):
+    """Return the text of each yaml or yml fenced block of the file, in order."""
+    try:
+        with open(path, encoding="utf-8") as handle:
+            text = handle.read()
+    except UnicodeDecodeError:
+        raise Refusal(f"{path} is not UTF-8")
+    except OSError as error:
+        raise Refusal(f"cannot read {path}: {error.strerror or error}")
+    blocks, fence, lines = [], None, None
+    for line in text.split("\n"):
+        if fence is None:
+            match = FENCE.fullmatch(line)
+            if match:
+                fence = match.group(1)
+                lines = [] if match.group(2).lower() in ("yaml", "yml") else None
+        elif re.fullmatch(r" {0,3}" + re.escape(fence[0]) + "{" + str(len(fence)) + r",}\s*", line):
+            if lines is not None:
+                blocks.append("\n".join(lines))
+            fence, lines = None, None
+        elif lines is not None:
+            lines.append(line)
+    if fence is not None:
+        raise Refusal(f"a fenced block of {path} is not closed")
+    return blocks
+
+
+def entry_of(state, step):
+    import yaml
+
+    for block in yaml_blocks(state):
+        try:
+            data = yaml.safe_load(block)
+        except yaml.YAMLError as error:
+            raise Refusal(f"a yaml block of {state} is not valid YAML: "
+                          + str(error).replace("\n", " "))
+        if isinstance(data, dict) and "dispatch" in data:
+            break
+    else:
+        raise Refusal(f"no yaml block of {state} has a dispatch: key")
+    dispatch = data["dispatch"]
+    entries = [dispatch] if isinstance(dispatch, dict) else dispatch
+    if not isinstance(entries, list):
+        entries = []
+    for entry in entries:
+        if isinstance(entry, dict) and str(entry.get("step")) == step:
+            return entry
+    raise Refusal(f"the dispatch block of {state} has no entry for step {step}")
+
+
+def ledger_root(root, state):
+    import yaml
+
+    config = os.path.join(root, ".agents", "plan.yaml")
+    try:
+        with open(config, encoding="utf-8") as handle:
+            data = yaml.safe_load(handle)
+    except (OSError, UnicodeDecodeError, yaml.YAMLError) as error:
+        raise Refusal(f"cannot read .agents/plan.yaml: {error}")
+    candidates = []
+    if isinstance(data, dict):
+        candidates.append(data.get("ledger_root"))
+        projects = data.get("projects")
+        if isinstance(projects, dict):
+            projects = list(projects.values())
+        for project in projects if isinstance(projects, list) else []:
+            if isinstance(project, dict):
+                candidates.append(project.get("ledger_root"))
+    folder = os.path.relpath(os.path.dirname(os.path.realpath(state)), root)
+    for candidate in candidates:
+        if not isinstance(candidate, str) or not candidate.strip():
+            continue
+        normal = os.path.normpath(candidate)
+        if normal.startswith("..") or os.path.isabs(normal) or normal == ".":
+            continue
+        if folder == normal or folder.startswith(normal + "/"):
+            return normal
+    raise Refusal(f"no ledger_root of .agents/plan.yaml holds the state file's folder {folder}")
+
+
+def changed_paths(worktree):
+    """Every path git status lists in the worktree, both paths of a rename or a copy."""
+    result = git("status", "--porcelain", "-z", "--untracked-files=all", cwd=worktree)
+    if result.returncode != 0:
+        raise Refusal(f"git status failed in {worktree}: "
+                      + result.stderr.decode(errors="replace").strip())
+    fields = result.stdout.decode("utf-8", errors="surrogateescape").split("\0")
+    paths, index = [], 0
+    while index < len(fields):
+        field = fields[index]
+        index += 1
+        if not field:
+            continue
+        status, path = field[:2], field[3:]
+        paths.append(path)
+        if "R" in status or "C" in status:
+            paths.append(fields[index])
+            index += 1
+    return paths
+
+
+def main(argv):
+    if len(argv) != 2:
+        raise Refusal("usage: remove_worktree.sh <state file> <step>")
+    state, step = argv
+    if not STEP.fullmatch(step):
+        raise Refusal(f"step '{step}' is not a step name: letters, digits, '.', '_' and '-'")
+    try:
+        import yaml  # noqa: F401
+    except ImportError:
+        print("error: python3 cannot import yaml (PyYAML)", file=sys.stderr)
+        return 69
+    root = os.getcwd()
+    if not os.path.isdir(os.path.join(root, ".git")):
+        raise Refusal("run this script from the repository root of the main checkout")
+    root = os.path.realpath(root)
+    entry = entry_of(state, step)
+    worktree = entry.get("worktree")
+    if not isinstance(worktree, str) or not worktree.strip():
+        raise Refusal(f"the entry of step {step} has no worktree: key")
+    path = os.path.realpath(os.path.join(root, worktree))
+    listed = git("worktree", "list", "--porcelain", cwd=root).stdout.decode(errors="replace")
+    if path == root or f"worktree {path}\n" not in listed + "\n" or not os.path.isdir(path):
+        raise Refusal(f"{worktree} is not a worktree of this repository")
+    branch = os.path.basename(path)
+    ledger = ledger_root(root, state)
+    outside = [p for p in changed_paths(path) if p != ledger and not p.startswith(ledger + "/")]
+    if outside:
+        for name in outside:
+            print(f"refused: {name} is outside the ledger root {ledger}")
+        return 1
+    result = git("worktree", "remove", "--force", path, cwd=root)
+    listed = git("worktree", "list", "--porcelain", cwd=root).stdout.decode(errors="replace")
+    if result.returncode != 0 or os.path.exists(path) or f"worktree {path}\n" in listed + "\n":
+        sys.stderr.write(result.stderr.decode(errors="replace"))
+        print(f"failed: git worktree remove --force {worktree}", file=sys.stderr)
+        return 1
+    print(f"removed: worktree {worktree}")
+    for name in (branch, branch + "-land"):
+        ref = f"refs/heads/{name}"
+        if git("rev-parse", "-q", "--verify", ref, cwd=root).returncode != 0:
+            continue
+        result = git("branch", "-D", name, cwd=root)
+        if result.returncode != 0 or git("rev-parse", "-q", "--verify", ref, cwd=root).returncode == 0:
+            sys.stderr.write(result.stderr.decode(errors="replace"))
+            print(f"failed: git branch -D {name}", file=sys.stderr)
+            return 1
+        print(f"removed: branch {name}")
+    return 0
+
+
+try:
+    sys.exit(main(sys.argv[1:]))
+except Refusal as refusal:
+    print(f"error: {refusal}", file=sys.stderr)
+    sys.exit(64)
+PY
