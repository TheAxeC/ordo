+++ b/skills/land/templates/remove_worktree.test.sh
@@ -0,0 +1,197 @@
+#!/bin/sh
+# Exercise remove_worktree.sh on scratch repositories shaped as land.sh leaves a step: the worktree
+# on <branch>-land, <branch> holding the wip commit, and ledger copies left uncommitted in the
+# worktree. Cases: a worktree holding only ledger copies (an untracked report, a modified plan.md,
+# a name holding a space and one holding a quote) removed with both branches; a worktree whose
+# folder name differs from the step id removed by its entry; a missing <branch>-land skipped; a
+# path outside the ledger root, and one whose name only starts with the ledger root's, refused
+# with nothing removed; a ledger root read from the projects: form; and each refusal on an
+# argument, a state file, an entry or a worktree the script cannot use.
+
+set -u
+
+fail() {
+    printf 'FAIL: %s\n' "$1" >&2
+    exit 1
+}
+
+test_root=$(mktemp -d "${TMPDIR:-/tmp}/remove-worktree-test.XXXXXX") ||
+    fail "could not create scratch directory"
+test_root=$(CDPATH= cd "$test_root" && pwd -P)
+trap 'rm -rf "$test_root"' 0 1 2 3 15
+script=$(CDPATH= cd "$(dirname "$0")" && pwd -P)/remove_worktree.sh
+
+g() {
+    git -c user.name=t -c user.email=t@t "$@"
+}
+
+# expect_in <text> <expected part> <what failed>
+expect_in() {
+    case "$1" in
+        *"$2"*) ;;
+        *) fail "$3; expected \"$2\" in: $1" ;;
+    esac
+}
+
+# run <args...>: runs the script from the current folder and sets out, err and status.
+run() {
+    sh "$script" "$@" >"$test_root/out" 2>"$test_root/err"
+    status=$?
+    out=$(cat "$test_root/out")
+    err=$(cat "$test_root/err")
+}
+
+# make_repo <name> <step> <worktree folder>: a repository at $test_root/<name> with a ledger
+# .scratch/p holding plan.md and a state file whose dispatch list holds the step's entry and one
+# other, and the step's worktree left as land.sh leaves a back-out: <folder> holds the wip
+# commit, the worktree is on <folder>-land. Sets repo, wt and state.
+make_repo() {
+    repo=$test_root/$1
+    mkdir -p "$repo/.agents" "$repo/.scratch/p/agents/reviews"
+    cd "$repo" || fail "could not enter $repo"
+    git init -q -b main
+    printf 'ledger_root: .scratch\nworktree_root: .agents/worktrees\n' >.agents/plan.yaml
+    printf '.agents/worktrees/\n' >.gitignore
+    printf '# Plan: p\n' >.scratch/p/plan.md
+    : >.scratch/p/agents/reviews/.gitkeep
+    state=.scratch/p/orchestrator-state.md
+    cat >"$state" <<STATE
+# State
+
+\`\`\`yaml
+dispatch:
+- step: '$2'
+  worktree: .agents/worktrees/$3
+  base: 0000000
+  landing: backed-out
+- step: other
+  worktree: .agents/worktrees/other
+  landing: not-started
+\`\`\`
+STATE
+    printf 'one\n' >src.txt
+    g add -A && g commit -q -m base || fail "could not commit the base"
+    wt=$repo/.agents/worktrees/$3
+    git worktree add -q -b "$3" "$wt" main || fail "could not add the worktree"
+    (cd "$wt" && printf 'two\n' >src.txt && g commit -q -a -m wip) || fail "no wip commit"
+    (cd "$wt" && git checkout -q -b "$3-land" main) || fail "could not check out $3-land"
+}
+
+# gone <folder>: the worktree and both branches are gone.
+gone() {
+    [ -e "$wt" ] && fail "the worktree $wt is still there"
+    git worktree list --porcelain | grep -q -F "worktree $wt" &&
+        fail "the worktree $wt is still registered"
+    git rev-parse -q --verify "refs/heads/$1" >/dev/null && fail "branch $1 is still there"
+    git rev-parse -q --verify "refs/heads/$1-land" >/dev/null && fail "branch $1-land is still there"
+    return 0
+}
+
+# kept <folder>: the worktree and both branches are all still there.
+kept() {
+    [ -d "$wt" ] || fail "the worktree $wt was removed"
+    git rev-parse -q --verify "refs/heads/$1" >/dev/null || fail "branch $1 was removed"
+    git rev-parse -q --verify "refs/heads/$1-land" >/dev/null || fail "branch $1-land was removed"
+}
+
+# Ledger copies only, in a worktree whose folder name (2b-22) differs from the step id (22).
+# Red when --force is dropped (git refuses the untracked files), when the status is read without
+# -z (the quoted names read as paths outside the ledger), when a path or a branch is built from
+# the step id, or when <branch>-land is not deleted.
+make_repo clean 22 2b-22
+printf 'report\n' >"$wt/.scratch/p/agents/reviews/22-report.md"
+printf 'ruling\n' >>"$wt/.scratch/p/plan.md"
+printf 'x\n' >"$wt/.scratch/p/agents/reviews/sp ace.md"
+printf 'x\n' >"$wt/.scratch/p/agents/reviews/quo\"te.md"
+run "$state" 22
+[ "$status" -eq 0 ] || fail "a worktree holding only ledger copies was not removed: $out $err"
+gone 2b-22
+expect_in "$out" "removed: worktree .agents/worktrees/2b-22" "the worktree's removal is not reported"
+expect_in "$out" "removed: branch 2b-22" "the branch's removal is not reported"
+expect_in "$out" "removed: branch 2b-22-land" "the landing branch's removal is not reported"
+git rev-parse -q --verify refs/heads/other >/dev/null && fail "a branch of another entry appeared"
+
+# A missing <branch>-land is skipped, with no line. Red when the script deletes it unguarded.
+make_repo noland s1 s1
+(cd "$wt" && git checkout -q s1 && git branch -q -D s1-land) || fail "could not drop s1-land"
+run "$state" s1
+[ "$status" -eq 0 ] || fail "a worktree with no landing branch was not removed: $out $err"
+[ -e "$wt" ] && fail "the worktree with no landing branch is still there"
+git rev-parse -q --verify refs/heads/s1 >/dev/null && fail "branch s1 is still there"
+case "$out" in
+    *"s1-land"*) fail "a line names the missing landing branch: $out" ;;
+esac
+
+# A path outside the ledger root is refused and nothing is removed. Red when the check is dropped.
+make_repo outside s2 s2
+printf 'report\n' >"$wt/.scratch/p/agents/reviews/s2-report.md"
+printf 'stray\n' >"$wt/stray.txt"
+printf 'x\n' >"$wt/src.txt"
+run "$state" s2
+[ "$status" -eq 1 ] || fail "a path outside the ledger root was not refused (exit $status): $out $err"
+expect_in "$out" "refused: stray.txt is outside the ledger root .scratch" \
+    "the untracked path outside the ledger is not named"
+expect_in "$out" "refused: src.txt is outside the ledger root .scratch" \
+    "the modified path outside the ledger is not named"
+case "$out" in
+    *"s2-report.md"* | *"removed:"*) fail "the refusal named a ledger copy or removed: $out" ;;
+esac
+kept s2
+
+# A name that only starts with the ledger root's is outside it. Red when the match drops the /.
+make_repo prefix s3 s3
+printf 'x\n' >"$wt/.scratchy"
+run "$state" s3
+[ "$status" -eq 1 ] || fail "a path .scratchy was taken as under .scratch (exit $status)"
+expect_in "$out" "refused: .scratchy is outside the ledger root .scratch" "the path .scratchy is not named"
+kept s3
+
+# The ledger root of a project, in the projects: form, is the one holding the state file.
+make_repo projects s4 s4
+printf 'projects:\n  a:\n    ledger_root: elsewhere\n  b:\n    ledger_root: ./.scratch/\n' \
+    >.agents/plan.yaml
+printf 'report\n' >"$wt/.scratch/p/agents/reviews/s4-report.md"
+run "$state" s4
+[ "$status" -eq 0 ] || fail "the projects: form's ledger root was not found: $out $err"
+gone s4
+
+# Refusals, each exit 64 with an error line and nothing removed.
+make_repo refusals s5 s5
+run
+[ "$status" -eq 64 ] || fail "no arguments did not exit 64 ($status)"
+expect_in "$err" "error: usage: remove_worktree.sh <state file> <step>" "no usage line"
+run "$state" 'bad step'
+[ "$status" -eq 64 ] || fail "a step name holding a space did not exit 64 ($status)"
+run .scratch/p/missing.md s5
+[ "$status" -eq 64 ] || fail "a missing state file did not exit 64 ($status)"
+expect_in "$err" "error: cannot read .scratch/p/missing.md" "the missing state file is not named"
+run "$state" s9
+[ "$status" -eq 64 ] || fail "a step with no entry did not exit 64 ($status)"
+expect_in "$err" "has no entry for step s9" "the missing entry is not named"
+run "$state" other
+[ "$status" -eq 64 ] || fail "an entry whose worktree does not exist did not exit 64 ($status)"
+expect_in "$err" "error: .agents/worktrees/other is not a worktree of this repository" \
+    "the worktree that is not one is not named"
+printf '# State\n\n```yaml\ndispatch:\n- step: s5\n  base: 0000000\n```\n' >.scratch/p/nowt.md
+run .scratch/p/nowt.md s5
+[ "$status" -eq 64 ] || fail "an entry with no worktree: key did not exit 64 ($status)"
+expect_in "$err" "error: the entry of step s5 has no worktree: key" "the missing key is not named"
+printf '# State\n\n```yaml\ndispatch: [\n```\n' >.scratch/p/broken.md
+run .scratch/p/broken.md s5
+[ "$status" -eq 64 ] || fail "a state file that is not valid YAML did not exit 64 ($status)"
+expect_in "$err" "is not valid YAML" "the invalid YAML is not named"
+(cd "$wt" && sh "$script" "$repo/$state" s5) >"$test_root/out" 2>"$test_root/err"
+[ "$?" -eq 64 ] || fail "a run from inside the worktree did not exit 64"
+expect_in "$(cat "$test_root/err")" "run this script from the repository root of the main checkout" \
+    "the run from the worktree is not refused with its message"
+mv .agents/plan.yaml .agents/plan.yaml.off
+run "$state" s5
+[ "$status" -eq 64 ] || fail "a missing .agents/plan.yaml did not exit 64 ($status)"
+expect_in "$err" "cannot read .agents/plan.yaml" "the missing plan.yaml is not named"
+mv .agents/plan.yaml.off .agents/plan.yaml
+kept s5
+run "$state" s5
+[ "$status" -eq 0 ] || fail "the worktree was not removed after the refusals: $out $err"
+gone s5
+
+printf 'PASS: remove_worktree.sh scratch tests\n'
