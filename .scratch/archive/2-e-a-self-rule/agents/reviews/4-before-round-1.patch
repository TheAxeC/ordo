+# The first lines of a successful run: the plan, the table's path and its first comment line, then a blank line.
+header() {
+    printf 'Plan %s: priced usage of its agents\n' "$1"
+    printf 'Prices from %s:\n' "${shown_table:-$table}"
+    printf '%s\n\n' 'Prices in US dollars per million tokens, copied by hand from https://platform.claude.com/docs/en/about-claude/pricing.'
+}
