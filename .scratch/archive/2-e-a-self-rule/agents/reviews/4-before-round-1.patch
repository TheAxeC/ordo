+# The hand-computed fixture in <folder>/ledger and <folder>/root, the agents listed out of order.
+main_fixture() {
+    ledger "$1/ledger" "$b_ag1" "$b_ar2" "$b_abc" "$b_ar1" "$b_ab1"
+    main_root "$1/root"
+}
