\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Cohort counts in the one-year and survival designs. Each exclusion count is stated against the 151,941 eligible patients, since the exclusion categories overlap. Prevalent or concurrent AF counts the patients with an AF diagnosis, or an ECG read as AF, before the end of the 30-day blanking window after the index ECG. These patients were excluded, and the count is not an outcome.}}{15}{table.1}\protected@file@percent }
\newlabel{tab:cohort}{{1}{15}{Cohort counts in the one-year and survival designs. Each exclusion count is stated against the 151,941 eligible patients, since the exclusion categories overlap. Prevalent or concurrent AF counts the patients with an AF diagnosis, or an ECG read as AF, before the end of the 30-day blanking window after the index ECG. These patients were excluded, and the count is not an outcome}{table.1}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.2}Discrimination at one year and across horizons}{15}{subsection.5.2}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces One-year discrimination in the one-year design (1,855 cases with four controls each, by design). AUROC is the bootstrap mean over 2,000 resamples with its 95\% percentile interval.}}{16}{table.2}\protected@file@percent }
\newlabel{tab:oneyear}{{2}{16}{One-year discrimination in the one-year design (1,855 cases with four controls each, by design). AUROC is the bootstrap mean over 2,000 resamples with its 95\% percentile interval}{table.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Discrimination at four horizons in the survival design. For each model, the cross-validated risk of every patient was read at all four horizons without refitting. Each horizon counts from the index ECG, and the shortest, 120 days, covers onset in the 90 days after the 30-day blanking window. AUROC is the full-sample estimate with its 95\% bootstrap percentile interval. The clinical Cox model has no interval.}}{16}{table.3}\protected@file@percent }
\newlabel{tab:horizons}{{3}{16}{Discrimination at four horizons in the survival design. For each model, the cross-validated risk of every patient was read at all four horizons without refitting. Each horizon counts from the index ECG, and the shortest, 120 days, covers onset in the 90 days after the 30-day blanking window. AUROC is the full-sample estimate with its 95\% bootstrap percentile interval. The clinical Cox model has no interval}{table.3}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.3}Calibration, risk stratification and operating points}{17}{subsection.5.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces One-year calibration, decision curves and risk deciles of the fused model (BTTN+clin, blue), the ECG-only BTTN (BTTN, orange) and the clinical model (clinical, green). The sample is the 19,986 patients of the survival design who had incident AF within one year or were followed for more than one year; 838 had AF within one year. Each model's risk score was converted to a probability by logistic recalibration with two-fold cross-fitting. Probabilities, AF rates and net benefit are given as proportions. Left: observed against mean predicted one-year AF in ten equal-count bins of each model's probability, with the dashed line marking equal values. Brier scores in the legend are rounded to three decimals. Middle: net benefit (vertical axis) against threshold probability, at the sample's one-year AF proportion, with treat-all (dotted) and treat-none (dashed) references. In the left and middle panels the three models differ by colour only. Right: observed one-year AF proportion in each decile of the fused model's probability, numbered 0 (lowest) to 9 (highest). The dashed line, labelled ``cohort prev'' in the image, marks the sample's one-year AF proportion. Points and bars carry no confidence intervals.}}{18}{figure.2}\protected@file@percent }
\newlabel{fig:clinical-utility}{{2}{18}{One-year calibration, decision curves and risk deciles of the fused model (BTTN+clin, blue), the ECG-only BTTN (BTTN, orange) and the clinical model (clinical, green). The sample is the 19,986 patients of the survival design who had incident AF within one year or were followed for more than one year; 838 had AF within one year. Each model's risk score was converted to a probability by logistic recalibration with two-fold cross-fitting. Probabilities, AF rates and net benefit are given as proportions. Left: observed against mean predicted one-year AF in ten equal-count bins of each model's probability, with the dashed line marking equal values. Brier scores in the legend are rounded to three decimals. Middle: net benefit (vertical axis) against threshold probability, at the sample's one-year AF proportion, with treat-all (dotted) and treat-none (dashed) references. In the left and middle panels the three models differ by colour only. Right: observed one-year AF proportion in each decile of the fused model's probability, numbered 0 (lowest) to 9 (highest). The dashed line, labelled ``cohort prev'' in the image, marks the sample's one-year AF proportion. Points and bars carry no confidence intervals}{figure.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Operating points at one year in the survival sample (19,986 patients, 838 cases) after cross-fitted recalibration. PPV and the number needed to monitor (NNM) are recomputed at the proportion of cases among the cases and AF-free controls of the one-year design, 1,855 in 43,625.}}{19}{table.4}\protected@file@percent }
\newlabel{tab:operating}{{4}{19}{Operating points at one year in the survival sample (19,986 patients, 838 cases) after cross-fitted recalibration. PPV and the number needed to monitor (NNM) are recomputed at the proportion of cases among the cases and AF-free controls of the one-year design, 1,855 in 43,625}{table.4}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.4}Cardiac-cycle occlusion profile}{19}{subsection.5.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Response of the ECG-only BTTN to beat-aligned occlusion, as the mean over 120 ECGs. The model was trained on the sample of the survival design. The ECGs are those of patients with incident AF to which the model gave the highest risk, passing over ECGs that could not be read or had fewer than three detected beats. Each panel shows one lead. The black trace is the mean of the ECGs' median beats, with each lead scaled to a maximum absolute amplitude of 1; the vertical scale is not shown. Time is relative to the R peak detected in lead II (dotted line). Occlusion windows of 12 samples (24~ms) are centred every 25~ms from 350~ms before to 425~ms after the R peak, with each centre rounded to a whole sample towards the R peak. Each shaded band spans the 25~ms step around its nominal centre. For each window, the window was set to zero in every beat of one lead, the spectrogram was rebuilt and the drop in log-risk was recorded. Shading depth shows the mean drop, with a negative mean set to zero, divided by the sum of the mean signal energy removed and one tenth of that energy averaged over all leads and windows. Depth is relative to the largest value in the figure, and windows below 3 percent of it are not shaded. The P, PR, QRS, ST and T windows of the text group the windows centred 225 to 150~ms before the R peak, 125 to 75~ms before, 50~ms before to 25~ms after, 50 to 125~ms after, and 150 to 375~ms after. The windows centred 350 to 250~ms before and at 400 and 425~ms after the R peak belong to none of the five. Table~\ref {tab:occlusion} gives the span of the beat that each group occludes. The shading describes the response of the fitted model to occlusion and is not an effect on the risk of AF.}}{20}{figure.3}\protected@file@percent }
\newlabel{fig:beat-saliency}{{3}{20}{Response of the ECG-only BTTN to beat-aligned occlusion, as the mean over 120 ECGs. The model was trained on the sample of the survival design. The ECGs are those of patients with incident AF to which the model gave the highest risk, passing over ECGs that could not be read or had fewer than three detected beats. Each panel shows one lead. The black trace is the mean of the ECGs' median beats, with each lead scaled to a maximum absolute amplitude of 1; the vertical scale is not shown. Time is relative to the R peak detected in lead II (dotted line). Occlusion windows of 12 samples (24~ms) are centred every 25~ms from 350~ms before to 425~ms after the R peak, with each centre rounded to a whole sample towards the R peak. Each shaded band spans the 25~ms step around its nominal centre. For each window, the window was set to zero in every beat of one lead, the spectrogram was rebuilt and the drop in log-risk was recorded. Shading depth shows the mean drop, with a negative mean set to zero, divided by the sum of the mean signal energy removed and one tenth of that energy averaged over all leads and windows. Depth is relative to the largest value in the figure, and windows below 3 percent of it are not shaded. The P, PR, QRS, ST and T windows of the text group the windows centred 225 to 150~ms before the R peak, 125 to 75~ms before, 50~ms before to 25~ms after, 50 to 125~ms after, and 150 to 375~ms after. The windows centred 350 to 250~ms before and at 400 and 425~ms after the R peak belong to none of the five. Table~\ref {tab:occlusion} gives the span of the beat that each group occludes. The shading describes the response of the fitted model to occlusion and is not an effect on the risk of AF}{figure.3}{}}
