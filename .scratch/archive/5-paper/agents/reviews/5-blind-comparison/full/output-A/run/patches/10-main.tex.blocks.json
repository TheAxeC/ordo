      "block_id": "B0070",
      "sha256": "3c895e1d447e8b12128daf66d3003faa22c0e697cfa04784137832bbc1daddae",
      "char_start": 38795,
      "char_end": 39209,
      "n_chars": 414,
      "section": "Calibration, risk stratification and operating points",
      "first_line_excerpt": "At the top 10\\% of risk, the fused model had a sensitivity of 0.272 against 0.240 for the clinical model, at s"
    },
    {
      "block_id": "B0071",
      "sha256": "b40a999c6a28ec87f1c960a843bcb6dd33bf96314d85d208b48013bb93cb743b",
      "char_start": 39211,
      "char_end": 39644,
      "n_chars": 433,
      "section": "Calibration, risk stratification and operating points",
      "first_line_excerpt": "The thresholds in this paragraph are read from the decision curves of Figure~\\ref{fig:clinical-utility}. All t"
    },
    {
