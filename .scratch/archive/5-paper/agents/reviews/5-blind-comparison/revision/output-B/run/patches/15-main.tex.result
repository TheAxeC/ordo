\setlength{\tabcolsep}{3pt}
\caption{Evaluation metrics. For $n$ records, $n_{ij}$ counts the records of class $i$ in cluster $j$, with class sizes $a_i$ and cluster sizes $b_j$. $Y$ is the class labelling and $\hat{Y}$ the cluster labelling, $H$ denotes entropy and $I = I(Y;\hat{Y})$ their mutual information. The last column gives the value under random labelling and the value when all records form one cluster.}
\label{tab:metrics}
\begin{tabular}{p{0.13\linewidth}p{0.22\linewidth}p{0.33\linewidth}p{0.09\linewidth}p{0.11\linewidth}}
\toprule
Metric & Meaning & Formula & Range & Random; one cluster \\
\midrule
ARI \cite{hubertarabie1985} & pairwise agreement of clusters and classes, corrected for chance & $(R - E)/(M - E)$, with $R = \sum_{ij}\binom{n_{ij}}{2}$, $M = \tfrac{1}{2}[\sum_i\binom{a_i}{2} + \sum_j\binom{b_j}{2}]$, $E = \sum_i\binom{a_i}{2}\sum_j\binom{b_j}{2}/\binom{n}{2}$ & at most 1, negative possible & 0; 0 \\
AMI \cite{vinh2010} & shared information, corrected for chance & $(I - \mathrm{E}[I])/(\tfrac{1}{2}[H(Y) + H(\hat{Y})] - \mathrm{E}[I])$ & at most 1, negative possible & 0; 0 \\
NMI \cite{Danon_2005} & shared information, normalised & $2I/(H(Y) + H(\hat{Y}))$ & $[0, 1]$ & near 0; 0 \\
V-measure \cite{rosenberg2007vmeasure} & harmonic mean of homogeneity $h$ and completeness $c$ & $2hc/(h + c)$, with $h = 1 - H(Y|\hat{Y})/H(Y)$, $c = 1 - H(\hat{Y}|Y)/H(\hat{Y})$ & $[0, 1]$ & near 0; 0 \\
FMI \cite{Fowlkes_1983} & geometric mean of pairwise precision and recall, not corrected for chance & $R/\sqrt{PQ}$, with $P = \sum_j\binom{b_j}{2}$, $Q = \sum_i\binom{a_i}{2}$ & $[0, 1]$ & above 0; 0.707 here \\
Purity & share of records in the majority class of their cluster & $\frac{1}{n}\sum_j \max_i n_{ij}$, noise clusters excluded from the sum & $[0, 1]$ & near 0.504; 0.504 \\
Silhouette \cite{rousseeuw1987} & compactness against separation in the conditioned representation & mean over non-noise points of $(d_{\mathrm{out}} - d_{\mathrm{in}})/\max(d_{\mathrm{in}}, d_{\mathrm{out}})$, with Euclidean mean distances to the own and the nearest other cluster & $[-1, 1]$ & near 0; undefined \\
Largest-cluster fraction & share of all records in the largest non-noise cluster & $\max_j b_j/n$ & $[0, 1]$ & near 0.5; 1 \\
Supervised ceiling & label information a linear classifier recovers & accuracy of a balanced logistic regression, patient-grouped five-fold cross-validation & $[0, 1]$ & 0.504; not applicable \\
\bottomrule
\end{tabular}
\end{table}

