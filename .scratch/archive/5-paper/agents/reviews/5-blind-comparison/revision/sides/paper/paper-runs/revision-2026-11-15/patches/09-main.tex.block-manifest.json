      "char_start": 12786,
      "char_end": 13565,
      "n_chars": 779,
      "section": "Data and cohorts",
      "first_line_excerpt": "\\paragraph{MIT-BIH.} For generalization we use the MIT-BIH Arrhythmia Database \\cite{mitbih2001,physionet2000}"
    },
    {
      "block_id": "B0027",
      "sha256": "91e4e2252c72a8cd819c7c8d185fb0b852b467bc889e68c5f638fa0e0c9a0a34",
