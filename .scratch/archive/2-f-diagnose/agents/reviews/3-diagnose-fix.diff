 # clone and prints a line for each, and removes a link into the pinned worktree whose agent the
 # tag lacks and prints a line for each. Every other entry of an agent folder, a user's own file or
 # a link to anywhere else, is left as it is.
+# An agent folder is also a skill folder when the two paths name one folder, however each is
+# spelled: each is read by its resolved path when it exists, and otherwise by its parent read the
+# same way followed by its last component, so a doubled trailing slash, a trailing /., a symbolic
+# link to the folder and a folder not yet created are all refused.
 # Check mode, and the check after linking, report an agent of the pinned worktree not linked from
 # an agent folder, every link into the live clone, and every link into the pinned worktree whose
 # agent the pinned worktree lacks.
@@ -141,6 +145,19 @@ agent_name() {
     esac
 }
 
+# Prints the folder the absolute path $1 names, so that two spellings of one folder print the same
+# line: its resolved path when it is a folder that exists, and otherwise its parent read the same
+# way followed by its last component, a last component of . or .. applied to the parent.
+folder_named() {
+    (CDPATH= cd "$1" 2>/dev/null && pwd -P) && return
+    named_parent=$(folder_named "$(dirname "$1")")
+    case "$(basename "$1")" in
+        .) printf '%s\n' "$named_parent" ;;
+        ..) dirname "$named_parent" ;;
+        *) printf '%s\n' "${named_parent%/}/$(basename "$1")" ;;
+    esac
+}
+
 # Succeeds when the list $1, one name per line, holds the name $2; an empty name is in no list.
 in_list() {
     [ -n "$2" ] || return 1
@@ -313,8 +330,10 @@ if [ -e "$stable" ]; then
     stable=$(CDPATH= cd "$stable" && pwd -P)
 fi
 while IFS= read -r agent_dir <&3; do
+    agent_folder=$(folder_named "$agent_dir")
     while IFS= read -r dir <&4; do
-        [ "${dir%/}" = "$agent_dir" ] && fail "$agent_dir is both a skill folder and an agent folder"
+        [ "$(folder_named "$dir")" = "$agent_folder" ] &&
+            fail "$agent_dir is both a skill folder and an agent folder"
     done 4<<EOF
 $skill_dirs
 EOF
