\label{tab:mitbih}
\begin{tabular}{lccc}
\toprule
Clusterer & hand-crafted beat (21) & conv-AE (32) & raw beat ($\sim$400) \\
\midrule
$k$-means & 0.750 & 0.110 & 0.018 \\
Ward      & \textbf{0.783} & 0.071 & 0.049 \\
GMM       & 0.679 & 0.127 & 0.018 \\
